# Used automatically by `npm run build` (the build you upload to the server).
# Vite picks this file for "production" mode, so a build never points at localhost.
VITE_API_BASE_URL=https://sahilmoney.in/WapHubBackend/api

# QR engine (Socket.IO) URL on the server. Fill this in with the real public
# URL of qr-engine-service; while it is commented out, the build falls back to
# http://localhost:4000 and the QR scanner will not connect in production.
# VITE_QR_ENGINE_WS_URL=https://YOUR-QR-ENGINE-HOST
