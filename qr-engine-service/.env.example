PORT=4000

# Origin(s) allowed to open the Socket.IO connection / call the REST API from a browser.
FRONTEND_ORIGIN=http://localhost:5173

# Base URL of backend-api (Laravel), used for:
#  - the outbound internal webhook (POST /api/internal/whatsapp-status)
#  - verifying a Socket.IO client's Bearer token via GET /api/auth/me
BACKEND_API_URL=http://localhost:8000

# Shared secret. Must be IDENTICAL to backend-api's INTERNAL_API_SECRET (.env).
# Guards: (a) inbound POST /api/qr/start-session and /api/qr/logout — only
# backend-api should be able to call these; (b) the outbound webhook, which
# backend-api's VerifyInternalSecret middleware checks on the way in.
INTERNAL_API_SECRET=devsecret_9f3a1c7b2e4d6a8f0b1c3d5e7f9a0b2c
