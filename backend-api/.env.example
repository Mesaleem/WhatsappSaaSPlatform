APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wa_saas_platform
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Module 4: qr-engine-service bridge
QR_ENGINE_SERVICE_URL=http://127.0.0.1:4000
INTERNAL_API_SECRET=devsecret_9f3a1c7b2e4d6a8f0b1c3d5e7f9a0b2c

# Social Media Marketing & Meta Ads Automation Expansion (Phase 1)
FRONTEND_URL=http://localhost:5173

# Phase 9 Task 2 — scheduled social connection health checks
# (social:check-connections every 15 min + the database:social worker, both in
# routes/console.php). A connection is checked with its provider at most once
# per interval; the batch caps how many are claimed per run.
SOCIAL_CONNECTION_CHECK_INTERVAL_MINUTES=60
SOCIAL_CONNECTION_CHECK_BATCH_SIZE=100

# Social Media Marketing & Meta Ads Automation Expansion (Final Phase) —
# AI Ad Copywriter. Both optional/unset by default: CopywriterService
# falls back to a deterministic template engine with no external call
# when neither key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Phase 8 AI foundation (config/ai.php). AI_PROVIDER empty = AI off.
# Keys above (OPENAI_API_KEY / ANTHROPIC_API_KEY) are reused; never commit real values.
# AI_PROVIDER: openai | anthropic | gemini
AI_PROVIDER=
AI_ENABLED_PROVIDERS=openai,anthropic,gemini
AI_TIMEOUT=30
AI_RETRIES=0
# Phase 8 Task 8 — Gemini (server-side only; platform key, never per tenant).
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_VERSION=v1beta
# Phase 8 Task 9 — embeddings + knowledge bases. Empty provider = embeddings off.
# AI_EMBEDDING_PROVIDER: openai | gemini (anthropic has no embedding API)
AI_EMBEDDING_PROVIDER=
AI_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_GEMINI_EMBEDDING_MODEL=gemini-embedding-001
KNOWLEDGE_MAX_DOCUMENT_CHARS=200000
KNOWLEDGE_CHUNK_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=200
# Phase 8 Task 7 — Journey AI nodes (prompt / agent). Empty allow-list = the node model hint is ignored.
AI_JOURNEY_MAX_TOKENS=500
AI_JOURNEY_ALLOWED_MODELS=
# Phase 8 Task 11 — registered AI agents: per-execution limits (an agent may only lower them)
# and the platform allow-list of tool ids agents may be granted.
AI_AGENT_MAX_MODEL_CALLS=4
AI_AGENT_MAX_TOOL_CALLS=3
AI_AGENT_MAX_EXECUTION_SECONDS=60
AI_AGENT_MAX_TOKENS=600
AI_AGENT_TOOLS=journey.variable.get,crm.lead.find_current,crm.lead.capture_current,crm.lead.update_status

# --- Phase 12 Task 2: edge security hardening (all optional; defaults shown) ---
# Login throttle: failed attempts per e-mail + IP within the window, then HTTP 429.
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_MINUTES=5
LOGIN_IP_MAX_ATTEMPTS=30
LOGIN_IP_DECAY_MINUTES=1
# Sanctum token lifetime in minutes. Unset/0 = tokens never expire (previous behavior).
SANCTUM_TOKEN_EXPIRATION_MINUTES=
# Outbound SSRF guard for tenant-controlled URLs (webhooks, media_url). Keep enabled outside local development.
OUTBOUND_GUARD_ENABLED=true
OUTBOUND_ALLOW_HTTP=true
OUTBOUND_ALLOWED_HOSTS=
OUTBOUND_MAX_REDIRECTS=3
# CORS: comma-separated allowed origins. Unset keeps today's behavior (*). Set to your front-end origin(s) in production.
CORS_ALLOWED_ORIGINS=
CORS_SUPPORTS_CREDENTIALS=false
# API security headers (X-Content-Type-Options, X-Frame-Options, Referrer-Policy, HSTS on HTTPS only).
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_ENABLED=true
SECURITY_HSTS_MAX_AGE=15552000

# --- Phase 12 Task 3: observability baseline (all optional; defaults keep today's behaviour) ----------------
# Structured JSON logs for production: LOG_CHANNEL=json (or add `json` to LOG_STACK). Default channel is unchanged.
# LOG_JSON_PATH=php://stderr
# LOG_JSON_TRACE=false
# GET /ready (readiness; /up stays liveness). The per-check detail needs header `X-Ops-Token: <this value>`;
# leave unset to never return detail.
# READINESS_DETAIL_TOKEN=
# true => a missing/stale scheduler heartbeat makes /ready answer 503 (default false: reported, not gating)
# READINESS_SCHEDULER_ENFORCE=false
# READINESS_SCHEDULER_MAX_AGE_SECONDS=180
# Slow-query log: OFF by default. Logs the query shape + duration only (never bindings).
# SLOW_QUERY_LOG_ENABLED=false
# SLOW_QUERY_THRESHOLD_MS=500
# SLOW_QUERY_MAX_PER_SHAPE_PER_MINUTE=3

# Public API server binding: keep false. true is a TEMPORARY emergency override that lets keys with no authorized server
# (created before binding existed) call /api/v1/* from any server. See config/api_binding.php.
# API_ALLOW_LEGACY_UNBOUND=false
